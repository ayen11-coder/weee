<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CRUD Data Hub</title>
  <style>
    :root {
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --bg-color: #f8fafc;
      --card-bg: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --danger: #ef4444;
      --danger-hover: #dc2626;
      --warning: #f59e0b;
      --warning-hover: #d97706;
      --success: #10b981;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    header {
      background-color: var(--card-bg);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 1px 2px rgba(0,0,0,0.05);
      position: sticky;
      top: 0;
      z-index: 10;
    }

    nav {
      max-width: 1000px;
      margin: 0 auto;
      display: flex;
      justify-content: center;
      gap: 8px;
      padding: 12px;
      overflow-x: auto;
    }

    .nav-btn {
      background: transparent;
      border: none;
      padding: 10px 18px;
      border-radius: 8px;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .nav-btn:hover {
      background-color: #f1f5f9;
      color: var(--text-main);
    }

    .nav-btn.active {
      background-color: var(--primary);
      color: white;
    }

    main {
      max-width: 1000px;
      width: 100%;
      margin: 24px auto;
      padding: 0 16px;
      flex: 1;
    }

    .interface {
      display: none;
      animation: fadeIn 0.3s ease;
    }

    .interface.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .card {
      background: var(--card-bg);
      border-radius: 12px;
      border: 1px solid var(--border);
      padding: 24px;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
      margin-bottom: 24px;
    }

    h2 {
      font-size: 1.5rem;
      margin-bottom: 6px;
      color: var(--text-main);
    }

    p.subtitle {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-bottom: 20px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 12px;
      margin-bottom: 12px;
    }

    input, select, textarea {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 14px;
      outline: none;
      transition: border-color 0.2s;
      background: #fff;
    }

    input:focus, select:focus, textarea:focus {
      border-color: var(--primary);
    }

    .btn {
      padding: 10px 16px;
      border-radius: 8px;
      border: none;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: var(--primary-hover); }

    .btn-warning { background: var(--warning); color: white; }
    .btn-warning:hover { background: var(--warning-hover); }

    .btn-danger { background: var(--danger); color: white; }
    .btn-danger:hover { background: var(--danger-hover); }

    .btn-sm {
      padding: 6px 10px;
      font-size: 12px;
    }

    .item-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 16px;
    }

    .item-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .item-title {
      font-weight: 700;
      font-size: 1.1rem;
      margin-bottom: 4px;
    }

    .item-meta {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 12px;
    }

    .item-actions {
      display: flex;
      gap: 8px;
      margin-top: 12px;
      border-top: 1px solid var(--border);
      padding-top: 12px;
    }

    .stats-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
    }

    .stat-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      padding: 20px;
      border-radius: 12px;
      text-align: center;
    }

    .stat-card h3 {
      font-size: 2rem;
      color: var(--primary);
    }

    .stat-card p {
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(15, 23, 42, 0.5);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 16px;
    }

    .modal-overlay.active { display: flex; }

    .modal {
      background: var(--card-bg);
      padding: 24px;
      border-radius: 12px;
      max-width: 500px;
      width: 100%;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }
  </style>
</head>
<body>

  <header>
    <nav>
      <button class="nav-btn active" onclick="switchTab('tab1')">Dashboard</button>
      <button class="nav-btn" onclick="switchTab('tab2')">Tasks</button>
      <button class="nav-btn" onclick="switchTab('tab3')">Contacts</button>
      <button class="nav-btn" onclick="switchTab('tab4')">Notes</button>
      <button class="nav-btn" onclick="switchTab('tab5')">Inventory</button>
    </nav>
  </header>

  <main>

    <section id="tab1" class="interface active">
      <div class="card">
        <h2>Dashboard Overview</h2>
        <p class="subtitle">Quick summary of all data stored in your system.</p>
        <div class="stats-container">
          <div class="stat-card">
            <h3 id="stat-tasks">0</h3>
            <p>Total Tasks</p>
          </div>
          <div class="stat-card">
            <h3 id="stat-contacts">0</h3>
            <p>Total Contacts</p>
          </div>
          <div class="stat-card">
            <h3 id="stat-notes">0</h3>
            <p>Total Notes</p>
          </div>
          <div class="stat-card">
            <h3 id="stat-inventory">0</h3>
            <p>Inventory Items</p>
          </div>
        </div>
      </div>
    </section>

    <section id="tab2" class="interface">
      <div class="card">
        <h2>Task Tracker</h2>
        <p class="subtitle">Add, complete, edit, and clear daily tasks.</p>
        <form onsubmit="createItem(event, 'tasks')">
          <div class="form-grid">
            <input type="text" id="task-name" placeholder="Task description..." required />
            <select id="task-priority">
              <option value="Low">Low Priority</option>
              <option value="Medium" selected>Medium Priority</option>
              <option value="High">High Priority</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary">+ Add Task</button>
        </form>
      </div>
      <div class="item-grid" id="container-tasks"></div>
    </section>

    <section id="tab3" class="interface">
      <div class="card">
        <h2>Contact Directory</h2>
        <p class="subtitle">Manage names, emails, and phone records.</p>
        <form onsubmit="createItem(event, 'contacts')">
          <div class="form-grid">
            <input type="text" id="contact-name" placeholder="Full Name" required />
            <input type="email" id="contact-email" placeholder="Email Address" required />
            <input type="tel" id="contact-phone" placeholder="Phone Number" required />
          </div>
          <button type="submit" class="btn btn-primary">+ Add Contact</button>
        </form>
      </div>
      <div class="item-grid" id="container-contacts"></div>
    </section>

    <section id="tab4" class="interface">
      <div class="card">
        <h2>Quick Notes</h2>
        <p class="subtitle">Save snippets, ideas, and remindable text.</p>
        <form onsubmit="createItem(event, 'notes')">
          <div class="form-grid" style="grid-template-columns: 1fr;">
            <input type="text" id="note-title" placeholder="Note Title" required />
            <textarea id="note-body" rows="3" placeholder="Write note content..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">+ Save Note</button>
        </form>
      </div>
      <div class="item-grid" id="container-notes"></div>
    </section>

    <section id="tab5" class="interface">
      <div class="card">
        <h2>Inventory Manager</h2>
        <p class="subtitle">Track stock quantities and item prices.</p>
        <form onsubmit="createItem(event, 'inventory')">
          <div class="form-grid">
            <input type="text" id="inv-name" placeholder="Item Name" required />
            <input type="number" id="inv-qty" placeholder="Quantity" min="0" required />
            <input type="number" id="inv-price" placeholder="Price ($)" step="0.01" min="0" required />
          </div>
          <button type="submit" class="btn btn-primary">+ Add Product</button>
        </form>
      </div>
      <div class="item-grid" id="container-inventory"></div>
    </section>
  </main>

  <div class="modal-overlay" id="editModal">
    <div class="modal">
      <div class="modal-header">
        <h3>Edit Item</h3>
        <button class="btn btn-sm" onclick="closeModal()">✕</button>
      </div>
      <div id="modal-fields"></div>
      <div style="display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px;">
        <button class="btn" onclick="closeModal()">Cancel</button>
        <button class="btn btn-primary" onclick="saveEdit()">Update</button>
      </div>
    </div>
  </div>

  <script>
   
    let activeModule = 'tasks';
    let editContext = null;

    function switchTab(tabId) {
      document.querySelectorAll('.interface').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));

      document.getElementById(tabId).classList.add('active');
      event.target.classList.add('active');

      updateDashboard();
    }

    function loadData(key) {
      return JSON.parse(localStorage.getItem(`app_${key}`)) || [];
    }

    function saveData(key, data) {
      localStorage.setItem(`app_${key}`, JSON.stringify(data));
      renderData(key);
      updateDashboard();
    }

    function createItem(event, type) {
      event.preventDefault();
      const list = loadData(type);
      let newItem = { id: Date.now() };

      if (type === 'tasks') {
        newItem.name = document.getElementById('task-name').value;
        newItem.priority = document.getElementById('task-priority').value;
      } else if (type === 'contacts') {
        newItem.name = document.getElementById('contact-name').value;
        newItem.email = document.getElementById('contact-email').value;
        newItem.phone = document.getElementById('contact-phone').value;
      } else if (type === 'notes') {
        newItem.title = document.getElementById('note-title').value;
        newItem.body = document.getElementById('note-body').value;
      } else if (type === 'inventory') {
        newItem.name = document.getElementById('inv-name').value;
        newItem.qty = document.getElementById('inv-qty').value;
        newItem.price = parseFloat(document.getElementById('inv-price').value).toFixed(2);
      }

      list.push(newItem);
      saveData(type, list);
      event.target.reset();
    }

    function renderData(type) {
      const container = document.getElementById(`container-${type}`);
      if (!container) return;
      
      const list = loadData(type);
      container.innerHTML = '';

      if (list.length === 0) {
        container.innerHTML = `<p style="color: var(--text-muted); grid-column: 1/-1;">No records found.</p>`;
        return;
      }

      list.forEach(item => {
        const card = document.createElement('div');
        card.className = 'item-card';

        let content = '';
        if (type === 'tasks') {
          content = `<div class="item-title">${escapeHtml(item.name)}</div>
                     <div class="item-meta">Priority: <strong>${item.priority}</strong></div>`;
        } else if (type === 'contacts') {
          content = `<div class="item-title">${escapeHtml(item.name)}</div>
                     <div class="item-meta">📧 ${escapeHtml(item.email)}<br>📞 ${escapeHtml(item.phone)}</div>`;
        } else if (type === 'notes') {
          content = `<div class="item-title">${escapeHtml(item.title)}</div>
                     <div class="item-meta">${escapeHtml(item.body)}</div>`;
        } else if (type === 'inventory') {
          content = `<div class="item-title">${escapeHtml(item.name)}</div>
                     <div class="item-meta">Stock: ${item.qty} units | Price: $${item.price}</div>`;
        }

        card.innerHTML = `
          <div>${content}</div>
          <div class="item-actions">
            <button class="btn btn-warning btn-sm" onclick="openEditModal('${type}', ${item.id})">Edit</button>
            <button class="btn btn-danger btn-sm" onclick="deleteItem('${type}', ${item.id})">Delete</button>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function openEditModal(type, id) {
      const list = loadData(type);
      const item = list.find(i => i.id === id);
      if (!item) return;

      editContext = { type, id };
      const fieldsContainer = document.getElementById('modal-fields');
      fieldsContainer.innerHTML = '';

      if (type === 'tasks') {
        fieldsContainer.innerHTML = `
          <input type="text" id="edit-val1" value="${escapeHtml(item.name)}" class="form-grid" style="margin-bottom: 8px;">
          <select id="edit-val2">
            <option value="Low" ${item.priority === 'Low' ? 'selected' : ''}>Low</option>
            <option value="Medium" ${item.priority === 'Medium' ? 'selected' : ''}>Medium</option>
            <option value="High" ${item.priority === 'High' ? 'selected' : ''}>High</option>
          </select>`;
      } else if (type === 'contacts') {
        fieldsContainer.innerHTML = `
          <input type="text" id="edit-val1" value="${escapeHtml(item.name)}" style="margin-bottom: 8px;">
          <input type="email" id="edit-val2" value="${escapeHtml(item.email)}" style="margin-bottom: 8px;">
          <input type="tel" id="edit-val3" value="${escapeHtml(item.phone)}">`;
      } else if (type === 'notes') {
        fieldsContainer.innerHTML = `
          <input type="text" id="edit-val1" value="${escapeHtml(item.title)}" style="margin-bottom: 8px;">
          <textarea id="edit-val2" rows="3">${escapeHtml(item.body)}</textarea>`;
      } else if (type === 'inventory') {
        fieldsContainer.innerHTML = `
          <input type="text" id="edit-val1" value="${escapeHtml(item.name)}" style="margin-bottom: 8px;">
          <input type="number" id="edit-val2" value="${item.qty}" style="margin-bottom: 8px;">
          <input type="number" id="edit-val3" step="0.01" value="${item.price}">`;
      }

      document.getElementById('editModal').classList.add('active');
    }

    function saveEdit() {
      if (!editContext) return;
      const { type, id } = editContext;
      let list = loadData(type);
      let item = list.find(i => i.id === id);

      if (type === 'tasks') {
        item.name = document.getElementById('edit-val1').value;
        item.priority = document.getElementById('edit-val2').value;
      } else if (type === 'contacts') {
        item.name = document.getElementById('edit-val1').value;
        item.email = document.getElementById('edit-val2').value;
        item.phone = document.getElementById('edit-val3').value;
      } else if (type === 'notes') {
        item.title = document.getElementById('edit-val1').value;
        item.body = document.getElementById('edit-val2').value;
      } else if (type === 'inventory') {
        item.name = document.getElementById('edit-val1').value;
        item.qty = document.getElementById('edit-val2').value;
        item.price = parseFloat(document.getElementById('edit-val3').value).toFixed(2);
      }

      saveData(type, list);
      closeModal();
    }

    function closeModal() {
      document.getElementById('editModal').classList.remove('active');
      editContext = null;
    }

    function deleteItem(type, id) {
      if (confirm('Are you sure you want to delete this record?')) {
        let list = loadData(type);
        list = list.filter(item => item.id !== id);
        saveData(type, list);
      }
    }

    function updateDashboard() {
      document.getElementById('stat-tasks').innerText = loadData('tasks').length;
      document.getElementById('stat-contacts').innerText = loadData('contacts').length;
      document.getElementById('stat-notes').innerText = loadData('notes').length;
      document.getElementById('stat-inventory').innerText = loadData('inventory').length;
    }

    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m]);
    }

    ['tasks', 'contacts', 'notes', 'inventory'].forEach(renderData);
    updateDashboard();
  </script>
</body>
</html>
